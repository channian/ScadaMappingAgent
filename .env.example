# Flask
SECRET_KEY=change-me-in-production

# SMTP
SMTP_SERVER=your-smtp-server
SMTP_PORT=25
SMTP_SENDER=sigma-tag@your-company.com

# PostgreSQL (SCADA + Employee DB)
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_DSN=hostname:5432
DB_NAME=TagSystem

# Default admin — created automatically on first startup if not in system_permissions
# Leave blank to skip
DEFAULT_ADMIN_EMPNO=
